// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())

  rating Int @default(1000)
  role Role @default(USER)

  boardPreset Json @default("[]")

  refreshTokens RefreshToken[]
  aiGameSessions AiGameSession[]
}

model RefreshToken {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  refreshToken String
  userAgent String?
  ip String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AiGameSession {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  playerBoard Json
  aiBoard Json
  currentTurn AiGameTurn @default(USER)
  status AiGameSessionStatus @default(ACTIVE)
  messages Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

enum Role {
  USER
  ADMIN
}

enum AiGameTurn {
  USER
  AI
}

enum AiGameSessionStatus {
  ACTIVE
  FINISHED
  EXPIRED
}
