// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())

  rating Int @default(1000)
  role Role @default(USER)

  boardPreset Json @default("[]")

  refreshTokens RefreshToken[]
  aiGameSessions AiGameSession[]
  onlineGamePlayers OnlineGamePlayer[]
}

model RefreshToken {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  refreshToken String
  userAgent String?
  ip String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AiGameSession {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  playerBoard Json
  aiBoard Json
  aiShotsHistory Json @default("[]")
  currentTurn AiGameTurn @default(USER)
  status GameSessionStatus @default(ACTIVE)
  messages Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
}

model OnlineGameSession {
  id Int @id @default(autoincrement())
  status GameSessionStatus @default(WAITING)
  currentTurnUserId Int?
  winnerUserId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  players OnlineGamePlayer[]
}

model OnlineGamePlayer {
  id Int @id @default(autoincrement())
  session OnlineGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  board Json
  isReady Boolean @default(false)
  slot OnlineGameSlot

  @@unique([sessionId, userId])
}

enum OnlineGameSlot {
  FIRST
  SECOND
}

enum Role {
  USER
  ADMIN
}

enum AiGameTurn {
  USER
  AI
}

enum GameSessionStatus {
  WAITING
  ACTIVE
  FINISHED
  EXPIRED
}
